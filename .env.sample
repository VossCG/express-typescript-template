NODE_ENV=development
PORT=3000
CORS_ORIGIN=*
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/backend_template?sslmode=disable
GOOGLE_CLIENT_ID=replace-with-your-google-oauth-client-id
JWT_SECRET=replace-with-at-least-32-random-characters
JWT_ISSUER=backend-template
JWT_AUDIENCE=backend-template-web
JWT_ACCESS_TTL_SECONDS=600
JWT_REFRESH_TTL_SECONDS=2592000
REFRESH_COOKIE_NAME=refresh_token
